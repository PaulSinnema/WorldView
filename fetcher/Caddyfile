# Serves the snapshots with automatic HTTPS (Let's Encrypt), compression and CORS
{$DOMAIN} {
	root * /srv
	encode zstd gzip
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Cache-Control "public, max-age=15"
		-Server
	}
	@options method OPTIONS
	respond @options 204
	# On-demand NS train details (key stays on the server)
	handle /ns/* {
		reverse_proxy fetcher:8080
	}
	# Live position of the selected aircraft (adsb.lol)
	handle /live/* {
		reverse_proxy fetcher:8080
	}
	# Aircraft near a point when zoomed in (adsb.lol, cached per area)
	handle /near/* {
		reverse_proxy fetcher:8080
	}
	# Flight legs per airport and per aircraft (legs.js)
	handle /airport/* {
		reverse_proxy fetcher:8080
	}
	handle /leg/* {
		reverse_proxy fetcher:8080
	}
	# Planned route and owner of an aircraft (adsbdb, routes.js)
	handle /flight/* {
		reverse_proxy fetcher:8080
	}
	handle {
		file_server
	}
}

# Sinnema Apps portal (container sinnema-apps from C:\Projects\SinnemaApps, same Docker network)
apps.sinnema.ch {
	reverse_proxy sinnema-apps:80
}
