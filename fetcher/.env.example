# Copy to .env and fill in
DOMAIN=flights.sinnema.ch
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between OpenSky world snapshots (4 credits each; 90 s = 3840 of 4000 credits/day, minimum ≈ 87)
OPENSKY_INTERVAL_S=90
# NS API Portal primary key (Virtual Train API), optional
NS_API_KEY=
# OpenAQ API key (air quality stations), optional
OPENAQ_API_KEY=
# Copernicus Atmosphere Data Store personal access token (ozone layer, CAMS), optional
ADS_API_KEY=
