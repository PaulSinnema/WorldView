        Star = k => RadioCall("radioFav", k),
        GoFn = "radioPlay", DetailsFn = "radioDetails"
    };

    // ---------- airport panel ----------
    private static readonly string[] AirportTypes = ["large", "medium"];
    private List<AirportItem> airportList = new();
    private List<RadioCountry> airportCountries = new();
    private int airportTotal, airportOffset;
    private string airportText = "", airportCountry = "", airportType = "", airportCity = "";
    private List<string> airportPlaces = new();
    private bool airportInView, airportAtcOnly, airportCollapsed = true; // starts collapsed
    private CancellationTokenSource? airportTextCts;
    private bool AirportFiltered => airportText != "" || airportCountry != "" || airportType != "" || airportCity != "" || airportInView || airportAtcOnly;
    private string AirportSummary
    {
        get
        {
            var count = airportTotal > 0 ? T("apt.count", "n", airportTotal.ToString("N0")) : AirportFiltered ? T("apt.none") : "";
            var country = airportCountries.FirstOrDefault(c => c.Cc == airportCountry)?.Name;
            var type = airportType != "" ? T("apt." + airportType) : null;
            var atc = airportAtcOnly ? T("apt.atc") : null;
            return string.Join(" · ", new[] { airportCity, country, type, atc, count }.Where(s => !string.IsNullOrEmpty(s)));
        }
    }

    private async Task LoadAirportCountries()
    {
        if (module is null) return;
        airportCountries = JsonSerializer.Deserialize<List<RadioCountry>>(await module.InvokeAsync<string>("airportCountries"), JsonOpts) ?? new();
        StateHasChanged();
    }

    private Task SendAirportQuery() => RadioCall("airportSetQuery", JsonSerializer.Serialize(new
    {
        q = airportText, cc = airportCountry, type = airportType, city = airportCity, inView = airportInView, atc = airportAtcOnly
    }));

    // Debounced: search after typing pauses (name and place share the timer)
    private async Task DebouncedAirportQuery()
    {
        airportTextCts?.Cancel();
        var cts = airportTextCts = new CancellationTokenSource();
        try { await Task.Delay(400, cts.Token); } catch (TaskCanceledException) { return; }
        await SendAirportQuery();
    }
    private Task OnAirportText(ChangeEventArgs e) { airportText = e.Value?.ToString() ?? ""; return DebouncedAirportQuery(); }
    private Task OnAirportCity(string v) { airportCity = v; return DebouncedAirportQuery(); }
    private List<Combo.Item> AirportPlaceItems => airportPlaces.Select(p => new Combo.Item(p, p)).ToList();
    private List<Combo.Item> AirportTypeItems => AirportTypes.Select(k => new Combo.Item(k, T("apt." + k))).ToList();
    private Task OnAirportCountry(string v) { airportCountry = v; return SendAirportQuery(); }
    private Task OnAirportType(string v) { airportType = v; return SendAirportQuery(); }
    private Task ToggleAirportInView() { airportInView = !airportInView; return SendAirportQuery(); }
    private Task ToggleAirportAtc() { airportAtcOnly = !airportAtcOnly; return SendAirportQuery(); }

    [JSInvokable]
    public void OnAirportList(string json)
    {
        var r = JsonSerializer.Deserialize<PagedList<AirportItem>>(json, JsonOpts);
        airportList = r?.Items ?? new();
        airportTotal = r?.Total ?? 0;
        airportOffset = r?.Offset ?? 0;
        airportPlaces = r?.Places ?? new();
        StateHasChanged();
    }



    [JSInvokable]
    public void OnMuseumList(string json)
    {
        var r = JsonSerializer.Deserialize<PagedList<MuseumItem>>(json, JsonOpts);
        museumList = r?.Items ?? new();
        museumTotal = r?.Total ?? 0;
        museumOffset = r?.Offset ?? 0;
        museumPlaces = r?.Places ?? new();
        StateHasChanged();
    }

    private async Task ShowToastAsync(string message)
    {
        var id = ++toastId;
        toast = message;
        StateHasChanged();
        await Task.Delay(4000);
        if (id != toastId) return;
        toast = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnLayerStatus(string layer, int count, string status)
    {
        layerStatus[layer] = (count, status);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCamera(double lat, double lon, double alt, double heading)
    {
        camLat = lat;
        camLon = lon;
        camAlt = alt;
        camHeading = heading;
        if (hud) StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSelect(string? json)
    {
        if (module is not null) isPhone = await module.InvokeAsync<bool>("isPhone"); // phones: no floating info box
        var prevKey = selection?.Key;
        selection = string.IsNullOrEmpty(json) ? null : JsonSerializer.Deserialize<SelectionInfo>(json, JsonOpts);
        if (selection?.Key != prevKey) { contacts = null; enlarged = false; follow = false; } // engine drops follow on a new selection
        StateHasChanged();
    }

    [JSInvokable]
    public void OnLayerChanged(string layer, bool on)
    {
        layers[layer] = on;
        if (layer == "radio" && on && radioCountries.Count == 0) _ = LoadRadioCountries();
        if (layer == "museums" && on) _ = LoadMuseumCountries();
        if (layer == "airports" && on) _ = LoadAirportCountries();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnStyleChanged(string newStyle)
    {
        style = newStyle;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnToggle(string name, bool on)
    {
        switch (name)
        {
            case "hud": hud = on; break;
            case "detect": detect = on; break;
            case "daynight": dayNight = on; break;
            case "borders": borders = on; break;
            case "timezones": timezones = on; if (on) _ = LoadTzZones(); break;
            case "cockpit": cockpit = on; break;
            case "listening": listening = on; break;
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnToast(string message) => _ = ShowToastAsync(message);

    [JSInvokable]
    public void OnVoice(string heard, string reply) => _ = ShowToastAsync($"🎙 \"{heard}\" {reply}");

    private string FormatLat(double v) => $"{Math.Abs(v):0.0000}°{T(v >= 0 ? "dir.n" : "dir.s")}";
    private string FormatLon(double v) => $"{Math.Abs(v):0.0000}°{T(v >= 0 ? "dir.e" : "dir.w")}";
    private static string FormatAlt(double m) => m >= 10000 ? $"{m / 1000:N0} km" : $"{m:N0} m";
    // Translated names only for "normal" and "snow"; the sensor names are universal
    private string StyleLabel(string key) => key switch
    {
        "normal" or "snow" => T("style." + key),
        "ironbow" => "Ironbow",
        "noir" => "Noir",
        _ => key.ToUpperInvariant()
    };

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }

