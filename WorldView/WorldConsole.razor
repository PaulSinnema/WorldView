    // ---------- row details (museum/radio list): folded open under the row, one at a time ----------
    private string? rowOpen, rowScroll, rowImg; // rowImg: enlarged museum photo
    private bool rowIsMuseum;
    private bool rowPhone; // row opened by a phone tap: the info box moves into it
    private bool isPhone; // set on every selection
    private bool InfoInRow => rowPhone && selection is not null && rowOpen == selection.Key;
    // Row of the selected item (info box) or the folded-open row
    private bool IsRowSel(string key) => key == selection?.Key || key == rowOpen;
    private RowDetails? rowDetails;

    private Task ToggleRow(string fn, string key)
    {
        if (rowOpen == key) { rowOpen = null; return Task.CompletedTask; }
        rowPhone = false;
        return OpenRow(fn, key);
    }

    // Row tap: select/play. On a phone it also folds the row open; a second tap on the open row only folds it shut
    private async Task RowClick(string action, string detailsFn, string key)
    {
        var phone = module is not null && await module.InvokeAsync<bool>("isPhone");
        if (phone && rowOpen == key) { rowOpen = null; return; }
        await RadioCall(action, key);
        if (phone) { rowPhone = true; await OpenRow(detailsFn, key); }
    }

    private async Task OpenRow(string fn, string key)
    {
        rowOpen = rowScroll = key;
        rowIsMuseum = fn is "museumDetails" or "airportDetails"; // photo left, enlargeable
        rowDetails = null; // shows "loading" until the details arrive
        if (module is null) return;
        var json = await module.InvokeAsync<string?>(fn, key);
        if (rowOpen != key) return; // another row was opened meanwhile
        rowDetails = string.IsNullOrEmpty(json) ? new RowDetails() : JsonSerializer.Deserialize<RowDetails>(json, JsonOpts);
        rowScroll = key; // again: the details changed the height
        StateHasChanged();
    }

    private RenderFragment RowDetailsBox() => @<li class="row-details @(InfoInRow ? "wide" : "")">
        @if (InfoInRow)
        {
            @InfoBox(true)
        }
        else if (rowDetails is null)
        {
            <span class="muted">…</span>
        }
        else
        {
            <div class="rd">
            @if (!string.IsNullOrEmpty(rowDetails.Image) && rowIsMuseum)
            {
                <img class="zoomable" src="@rowDetails.Image" alt="" title="@T("info.enlarge")" referrerpolicy="no-referrer" onerror="this.style.display='none'" @onclick="() => rowImg = rowDetails.Image" />
            }
            else if (!string.IsNullOrEmpty(rowDetails.Image))
            {
                <img src="@rowDetails.Image" alt="" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
            }
            <div class="rd-text">
            <table>
                @foreach (var f in rowDetails.Fields)
                {
                    if (f.Length < 2) continue;
                    <tr><th>@f[0]</th><td>
                        @if (f[1].StartsWith("https://") || f[1].StartsWith("http://"))
                        {
                            <a href="@f[1]" target="_blank" rel="noopener noreferrer">@f[1]</a>
                        }
                        else
                        {
                            @f[1]
                        }
                    </td></tr>
                }
            </table>
            @if (!string.IsNullOrEmpty(rowDetails.Summary))
            {
                <p>@rowDetails.Summary</p>
            }
            @if (!string.IsNullOrEmpty(rowDetails.Link))
            {
                <a href="@rowDetails.Link" target="_blank" rel="noopener noreferrer">Wikipedia ↗</a>
            }
            </div>
            </div>
        }
    </li>;

    // Last filters of the list panels (saved by the engine on every query); new panels add their fields to PanelFilter
    private async Task RestorePanelFilters()
    {
        if (module is null) return;
        try
        {
            var r = JsonSerializer.Deserialize<PanelFilter>(await module.InvokeAsync<string>("getPanelFilter", "radio"), JsonOpts) ?? new();
            radioText = r.Q; radioCountry = r.Cc; radioGenre = r.Tag; radioInView = r.InView; radioFavOnly = r.Fav;
            var m = JsonSerializer.Deserialize<PanelFilter>(await module.InvokeAsync<string>("getPanelFilter", "museums"), JsonOpts) ?? new();
            museumText = m.Q; museumCountry = m.Cc; museumType = m.Type; museumCity = m.City; museumInView = m.InView; museumWikiOnly = m.Wiki;
            var a = JsonSerializer.Deserialize<PanelFilter>(await module.InvokeAsync<string>("getPanelFilter", "airports"), JsonOpts) ?? new();
            airportText = a.Q; airportCountry = a.Cc; airportType = a.Type; airportCity = a.City; airportInView = a.InView; airportAtcOnly = a.Atc;
            foreach (var d in ListDefs)
            {
                var f = JsonSerializer.Deserialize<PanelFilter>(await module.InvokeAsync<string>("getPanelFilter", d.Name), JsonOpts) ?? new();
                var s = lists[d.Name];
                s.Q = f.Q; s.Q2 = f.Q2; s.A = f.A; s.B = f.B; s.InView = f.InView; s.Flag = f.Flag;
            }
            StateHasChanged();
        }
        catch { /* no saved filter: defaults */ }
    }

