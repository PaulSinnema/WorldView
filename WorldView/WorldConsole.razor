    private static string TzName(double z)
    {
        if (z == 0) return "UTC";
        var a = Math.Abs(z);
        var h = (int)Math.Floor(a);
        var m = (int)Math.Round((a - h) * 60);
        return $"UTC{(z < 0 ? "−" : "+")}{h}{(m > 0 ? $":{m:00}" : "")}";
    }

