    // ---------- generic list panels (satellites, launches); engine side: LISTS in worldview.js ----------
    private sealed record ListDef(string Name, string Icon, string Search, string? AllA, string? AllB, string? Flag, string GoFn, string DetailsFn, string FlagIcon = "🎥", string? Search2 = null);
    private static readonly ListDef[] ListDefs =
    [
        new("flights", "✈", "flt.callsign", null, null, null, "flightGo", "flightDetails", Search2: "flt.reg"),
        new("military", "✈", "flt.callsign", null, null, null, "milGo", "milDetails", Search2: "flt.reg"),
        new("satellites", "🛰", "sat.search", "sat.allGroups", null, "list.model", "satGo", "satDetails", "🧊"),
        new("telescopes", "🔭", "tel.search", "sat.allGroups", null, "list.model", "telGo", "telDetails", "🧊"),
        new("launches", "🚀", "lch.search", "lch.allProviders", "lch.allStatus", "lch.webcast", "launchGo", "launchDetails")
    ];
    private sealed class ListState
    {
        public string Q = "", Q2 = "", A = "", B = "";
        public bool InView, Flag, Collapsed = true; // starts collapsed
        public int Total, Offset;
        public List<ListRow> Items = new();
        public List<Combo.Item> OptA = new(), OptB = new();
        public CancellationTokenSource? Cts;
    }
    private sealed class ListRow
    {
        public string Key { get; set; } = "";
        public string Name { get; set; } = "";
        public string Sub { get; set; } = "";
        public bool Flag { get; set; }
    }
    private sealed class ListOpt
    {
        public string K { get; set; } = "";
        public string V { get; set; } = "";
    }
    private sealed class ListPayload
    {
        public int Total { get; set; }
        public int Offset { get; set; }
        public List<ListRow> Items { get; set; } = new();
        public List<ListOpt> A { get; set; } = new();
        public List<ListOpt> B { get; set; } = new();
    }
    private readonly Dictionary<string, ListState> lists = ListDefs.ToDictionary(d => d.Name, _ => new ListState());

    // Opening a panel asks the engine for a fresh list (an early list may have been sent before the UI was ready)
    private Task ToggleList(string name)
    {
        var s = lists[name];
        s.Collapsed = !s.Collapsed;
        return s.Collapsed ? Task.CompletedTask : SendList(name);
    }
    private Task SendList(string name)
    {
        var s = lists[name];
        return RadioCall("listSetQuery", name, JsonSerializer.Serialize(new { q = s.Q, q2 = s.Q2, a = s.A, b = s.B, inView = s.InView, flag = s.Flag }));
    }
    private async Task DebouncedList(string name)
    {
        var s = lists[name];
        s.Cts?.Cancel();
        var cts = s.Cts = new CancellationTokenSource();
        try { await Task.Delay(400, cts.Token); } catch (TaskCanceledException) { return; }
        await SendList(name);
    }
    private string ListSummary(ListDef d)
    {
        var s = lists[d.Name];
        var filtered = s.Q != "" || s.Q2 != "" || s.A != "" || s.B != "" || s.InView || s.Flag;
        var count = s.Total > 0 ? T("list.count", "n", s.Total.ToString("N0")) : filtered ? T("list.none") : "";
        var a = s.OptA.FirstOrDefault(o => o.Value == s.A)?.Label;
        var b = s.OptB.FirstOrDefault(o => o.Value == s.B)?.Label;
        return string.Join(" · ", new[] { a, b, s.Flag && d.Flag is not null ? T(d.Flag) : null, count }.Where(x => !string.IsNullOrEmpty(x)));
    }

    [JSInvokable]
    public void OnList(string name, string json)
    {
        if (!lists.TryGetValue(name, out var s)) return;
        var r = JsonSerializer.Deserialize<ListPayload>(json, JsonOpts);
        s.Items = r?.Items ?? new();
        s.Total = r?.Total ?? 0;
        s.Offset = r?.Offset ?? 0;
        s.OptA = (r?.A ?? new()).Select(o => new Combo.Item(o.K, o.V)).ToList();
        s.OptB = (r?.B ?? new()).Select(o => new Combo.Item(o.K, o.V)).ToList();
        StateHasChanged();
    }

    private RenderFragment ListPanel(ListDef d)
    {
        var s = lists[d.Name];
        return DockPanel(new DockSpec
        {
            Collapsed = s.Collapsed,
            Toggle = () => ToggleList(d.Name),
            Head = PanelHead(T("layer." + d.Name), ListSummary(d)),
            Filters = @<span class="pf">
                <input type="search" value="@s.Q" @oninput='e => { s.Q = e.Value?.ToString() ?? ""; return DebouncedList(d.Name); }' placeholder="@T(d.Search)" aria-label="@T(d.Search)" />
                @if (d.Search2 is not null)
                {
                    <input type="search" value="@s.Q2" @oninput='e => { s.Q2 = e.Value?.ToString() ?? ""; return DebouncedList(d.Name); }' placeholder="@T(d.Search2)" aria-label="@T(d.Search2)" />
                }
                @if (d.AllA is not null)
                {
                    <Combo Items="s.OptA" Value="@s.A" ValueChanged='v => { s.A = v; return SendList(d.Name); }' Placeholder="@T(d.AllA)" />
                }
                @if (d.AllB is not null)
                {
                    <Combo Items="s.OptB" Value="@s.B" ValueChanged='v => { s.B = v; return SendList(d.Name); }' Placeholder="@T(d.AllB)" />
                }
                <button class="@(s.InView ? "active" : "")" @onclick='() => { s.InView = !s.InView; return SendList(d.Name); }'>@T("radio.inView")</button>
                @if (d.Flag is not null)
                {
                    <button class="@(s.Flag ? "active" : "")" @onclick='() => { s.Flag = !s.Flag; return SendList(d.Name); }'>@d.FlagIcon @T(d.Flag)</button>
                }
            </span>,
            Total = s.Total, Offset = s.Offset, Count = s.Items.Count,
            Page = dir => RadioCall("listPage", d.Name, dir),
            Rows = s.Items.Select(it => new PanelRow(it.Key, it.Name, it.Sub, it.Flag ? d.FlagIcon : d.Icon)),
            GoFn = d.GoFn, DetailsFn = d.DetailsFn
        });
    }

    // ---------- shared dock panel: head, filters, pager, rows with details ----------
    private sealed class DockSpec
    {
        public string Css = "";
        public bool Collapsed;
        public Func<Task> Toggle = () => Task.CompletedTask;
        public RenderFragment? Head, Ctrl, Filters, PagerInfo; // Ctrl: head buttons; PagerInfo: text before the pager
        public int Total, Offset, Count;
        public Func<int, Task> Page = _ => Task.CompletedTask;
        public IEnumerable<PanelRow> Rows = [];
        public Func<string, Task>? Star; // star button per row (radio favourites)
        public string GoFn = "", DetailsFn = "";
    }
    private sealed record PanelRow(string Key, string Name, string Sub, string Icon, string? IconUrl = null, string? Css = null, bool Fav = false);

    private static string Join(params string?[] parts) => string.Join(" · ", parts.Where(x => !string.IsNullOrEmpty(x)));

    private RenderFragment PanelHead(string title, string? sub, bool on = false) => @<span class="radio-now @(on ? "on" : "")">
        <b>@title</b>
        @if (!string.IsNullOrEmpty(sub))
        {
            <span>@sub</span>
        }
    </span>;

    private RenderFragment DockPanel(DockSpec p) => @<section class="radio @p.Css @(p.Collapsed ? "collapsed" : "")">
        <div class="radio-head" title="@T("radio.collapse")" @onclick="p.Toggle">
            @p.Head
            @if (p.Ctrl is not null)
            {
                @* Controls: a tap on them must not fold the panel *@
                <span class="radio-ctrl" @onclick:stopPropagation="true">@p.Ctrl</span>
            }
        </div>
        @if (!p.Collapsed)
        {
            <div class="radio-filters">
                @p.Filters
                @if (p.PagerInfo is not null || p.Total > p.Count)
                {
                    <span class="pager">
                        @p.PagerInfo
                        @if (p.Total > p.Count)
                        {
                            <button disabled="@(p.Offset == 0)" @onclick="() => p.Page(-1)">◀</button>
                            <span>@((p.Offset + 1).ToString("N0"))–@((p.Offset + p.Count).ToString("N0"))</span>
                            <button disabled="@(p.Offset + p.Count >= p.Total)" @onclick="() => p.Page(1)">▶</button>
                        }
                    </span>
                }
            </div>
            <ul class="radio-list" @key="p.Offset">
                @foreach (var r in p.Rows)
                {
                    <li data-key="@r.Key" class="@r.Css @(IsRowSel(r.Key) ? "sel" : "")" @onclick="() => RowClick(p.GoFn, p.DetailsFn, r.Key)">
                        @if (!string.IsNullOrEmpty(r.IconUrl))
                        {
                            <img src="@r.IconUrl" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.visibility='hidden'" />
                        }
                        else
                        {
                            <span class="noicon">@r.Icon</span>
                        }
                        <span class="rs-main">
                            <b>@r.Name</b>
                            <span>@r.Sub</span>
                        </span>
                        @if (p.Star is not null)
                        {
                            <button class="star @(r.Fav ? "on" : "")" title="@T("radio.fav")" @onclick="() => p.Star(r.Key)" @onclick:stopPropagation="true">★</button>
                        }
                        <button class="fold @(rowOpen == r.Key ? "on" : "")" title="@T("row.details")" @onclick="() => ToggleRow(p.DetailsFn, r.Key)" @onclick:stopPropagation="true">@(rowOpen == r.Key ? "▾" : "▸")</button>
                    </li>
                    @if (rowOpen == r.Key)
                    {
                        @RowDetailsBox()
                    }
                }
            </ul>
        }
    </section>;

