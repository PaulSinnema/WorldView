@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="globe" class="globe"></div>

<div class="version">v@(AppVersion)</div>

@if (loading)
{
    <div class="boot">@(L.Count > 0 ? T("boot.init") : "WORLDVIEW · …")</div>
}
else if (error is not null)
{
    <div class="boot error">
        <div>@(L.Count > 0 ? T("boot.fail") : "WorldView")</div>
        <div>@error</div>
    </div>
}

@if (hud && !loading)
{
    <div class="hud">
        <div class="hud-title">WORLDVIEW</div>
        <div>@DateTime.UtcNow.ToString("HH:mm:ss") UTC</div>
        <div>POS @FormatLat(camLat) @FormatLon(camLon)</div>
        <div>ALT @FormatAlt(camAlt) · HDG @camHeading.ToString("000")°</div>
        <div>@T("hud.optics") @StyleLabel(style).ToUpperInvariant()@(detect ? " · " + T("hud.detect") : "")@(cockpit ? " · COCKPIT" : "")</div>
        @if (!string.IsNullOrEmpty(envSource))
        {
            <div>@T("hud.layer") @T("env." + envOverlay).ToUpperInvariant() · @T("hud.source") @envSource</div>
        }
        @if (selection is not null)
        {
            <div class="hud-target">@T("hud.target") @selection.Title</div>
        }
    </div>
    <div class="crosshair"></div>
}

<div class="topbar">
    <form class="search" @onsubmit="DoSearch">
        <input @bind="searchText" @bind:event="oninput" placeholder="@T("search.placeholder")" aria-label="@T("search.title")" />
        <button type="submit" title="@T("search.title")">⌕</button>
    </form>
    <button class="mic @(listening ? "on" : "")" title="@T("voice.title")" @onclick="StartVoice">🎙</button>
    <button title="@T("btn.north")" @onclick='() => Call("northUp")'>N↑</button>
    <button title="@T("btn.myPos")" @onclick='() => Call("flyToMe")'>◉</button>
    <button title="@T("help.title")" @onclick="OpenHelp">?</button>
    <button title="@T("panel.title")" @onclick="() => panelToggled = !panelToggled">☰</button>
</div>

<aside class="panel @(panelToggled ? "toggled" : "")">
    <h3>@T("sec.lang")</h3>
    <select value="@lang" @onchange="OnLangChange" aria-label="@T("sec.lang")">
        @foreach (var (langCode, langName) in langs)
        {
            <option value="@langCode">@langName</option>
        }
    </select>

    <h3>@T("sec.env")</h3>
    <select value="@envOverlay" @onchange="OnEnvOverlayChange" aria-label="@T("sec.env")">
        <option value="">@T("env.none")</option>
        @foreach (var e in EnvLayers)
        {
            var missing = envMissing.Contains(e);
            <option value="@e" disabled="@missing">@T("env." + e)@(missing ? " " + T("env.needsKey") : "")</option>
        }
    </select>
    @if (!string.IsNullOrEmpty(envLegend))
    {
        @* Colour bar with units (NASA GIBS) *@
        <img class="env-legend" src="@envLegend" alt="@T("env.legend")" />
    }
    @if (envOverlay.StartsWith("ozone"))
    {
        @* KNMI/TEMIS assimilated total ozone, polar views (images only) *@
        <div class="hint">@T("env.knmi")</div>
        <div class="knmi">
            <img src="@KnmiUrl("np", true)" alt="KNMI N" @onclick='() => knmiImg = KnmiUrl("np", false)' />
            <img src="@KnmiUrl("sp", true)" alt="KNMI S" @onclick='() => knmiImg = KnmiUrl("sp", false)' />
        </div>
    }
    <div class="toggles" style="margin-top:4px; grid-template-columns: 1fr">
        <button class="@(envClick ? "active" : "")" @onclick="ToggleEnvClick">@T("env.click")</button>
    </div>
    <div class="hint">@T("env.hint")</div>

    <h3>@T("sec.layers")</h3>
    @foreach (var l in LayerDefs)
    {
        var on = layers.GetValueOrDefault(l.Key);
        var st = layerStatus.GetValueOrDefault(l.Key);
        var zoom = zoomOn.GetValueOrDefault(l.Key);
        <div class="layer-row">
            <label class="layer">
                <input type="checkbox" checked="@on" @onchange="e => ToggleLayer(l.Key, e.Value is true)" />
                <span class="dot" style="background:@l.Color"></span>
                <span class="name">@T("layer." + l.Key)</span>
                <span class="count">@(on && st.Count > 0 ? st.Count.ToString("N0") : "")</span>
            </label>
            <button class="zoom @(zoom ? "active" : "")" title="@T(zoom ? "zoom.on" : "zoom.off")" @onclick="() => ToggleZoom(l.Key)">⌖</button>
        </div>
        @if (on && !string.IsNullOrEmpty(st.Status))
        {
            <div class="layer-status">@st.Status</div>
        }
    }

    <h3>@T("sec.optics")</h3>
    <div class="styles">
        @for (var i = 0; i < Styles.Length; i++)
        {
            var s = Styles[i];
            var n = i + 1;
            <button class="@(style == s ? "active" : "")" @onclick="() => SetStyle(s)"><b>@n</b> @StyleLabel(s)</button>
        }
    </div>

    <h3>@T("sec.display")</h3>
    <div class="toggles">
        <button class="@(hud ? "active" : "")" @onclick="ToggleHud">H · HUD</button>
        <button class="@(detect ? "active" : "")" @onclick="ToggleDetect">D · @T("btn.detect")</button>
        <button class="@(dayNight ? "active" : "")" @onclick="ToggleDayNight">N · @T("btn.daynight")</button>
        <button class="@(trails ? "active" : "")" @onclick="ToggleTrails" title="@T("hint.trails")">@T("btn.trails")</button>
        <button class="@(borders ? "active" : "")" @onclick="ToggleBorders">B · @T("btn.borders")</button>
    </div>
    @if (borders)
    {
        <div class="toggles" style="margin-top:4px">
            <button class="@(regions ? "active" : "")" @onclick="ToggleRegions">@T("btn.regions")</button>
            <button class="@(cities ? "active" : "")" @onclick="ToggleCities">@T("btn.cities")</button>
            <button class="@(coast ? "active" : "")" @onclick="ToggleCoast">@T("btn.coast")</button>
            <button class="@(eez ? "active" : "")" @onclick="ToggleEez" title="@T("hint.eez")">@T("btn.eez")</button>
        </div>
    }
    <div class="toggles" style="margin-top:4px">
        <button class="@(timezones ? "active" : "")" @onclick="ToggleTimezones">Z · @T("btn.timezones")</button>
        <button class="@(nature ? "active" : "")" @onclick="ToggleNature" title="@T("hint.nature")">@T("btn.nature")</button>
        <button class="@(streets ? "active" : "")" @onclick="ToggleStreets" title="@T("hint.streets")">@T("btn.streets")</button>
    </div>
    @if (timezones && tzZones.Count > 0)
    {
        @* Legend: current time per zone; click highlights the zone on the globe *@
        <div class="tz-legend" role="listbox" aria-label="@T("btn.timezones")">
            @for (var i = 0; i < tzZones.Count; i++)
            {
                var idx = i;
                <button class="@(tzSelected == idx ? "active" : "")" @onclick="() => SelectTz(idx)">
                    <span>@TzName(tzZones[idx])</span><b>@DateTime.UtcNow.AddHours(tzZones[idx]).ToString("HH:mm")</b>
                </button>
            }
        </div>
    }
    @if (detect)
    {
        @* Detection labels: size, optional black plate with its opacity *@
        <label class="slider">
            <span>@T("det.font")</span>
            <input type="range" min="10" max="24" value="@detectFont" @oninput='e => SetDetectStyle(e, "font")' aria-label="@T("det.font")" />
            <span>@(detectFont)px</span>
        </label>
        <div class="toggles" style="margin-top:4px">
            <button class="@(detectBg ? "active" : "")" @onclick='() => SetDetectStyle(null, "bg")'>@T("det.bg")</button>
        </div>
        @if (detectBg)
        {
            <label class="slider">
                <span>@T("det.bgAlpha")</span>
                <input type="range" min="0" max="100" value="@detectBgAlpha" @oninput='e => SetDetectStyle(e, "alpha")' aria-label="@T("det.bgAlpha")" />
                <span>@detectBgAlpha%</span>
            </label>
        }
    }
    @if (dayNight)
    {
        <label class="slider">
            <span>@T("night")</span>
            <input type="range" min="0" max="100" value="@nightLight" @oninput="SetNightLight" aria-label="@T("night.aria")" />
            <span>@nightLight%</span>
        </label>
    }
    @if (!string.IsNullOrEmpty(gpu))
    {
        <div class="hint">GPU: @gpu</div>
    }

    <h3>@T("sec.map")</h3>
    <select value="@basemap" @onchange="OnBasemapChange">
        <option value="esri">@T("map.esri")</option>
        <option value="dark">@T("map.dark")</option>
        <option value="osm">@T("map.osm")</option>
        <option value="google">@T("map.google")</option>
    </select>
    <div class="actions">
        <button @onclick="ResetGlobe">⌂ @T("btn.reset")</button>
        <button @onclick="Share">🔗 @T("btn.share")</button>
    </div>

    <h3>POWER UP</h3>
    <div class="powerup">
        <input type="password" @bind="ionToken" @bind:event="oninput" placeholder="@T("ion.placeholder")" aria-label="@T("ion.placeholder")" />
        <button @onclick="SaveToken">@T("btn.save")</button>
    </div>
    <div class="hint">@T("hint.sources")</div>
    <div class="keys">@T("hint.keys")</div>
</aside>

@if (showHelp)
{
    @* Help page: click outside, ✕ or Esc closes *@
    <div class="help" @onclick="CloseHelp" @onkeydown="HelpKey" tabindex="-1" @ref="helpRef">
        <div class="help-box" @onclick:stopPropagation="true">
            <header>
                <span>WORLDVIEW · @T("help.title")</span>
                <button class="x" title="@T("info.close")" @onclick="CloseHelp">✕</button>
            </header>
            <nav>
                @for (var i = 0; i < helpSections.Count; i++)
                {
                    var id = $"help-{i}";
                    <button @onclick='() => JS.InvokeVoidAsync("wvScrollTo", id)'>@helpSections[i].Icon @helpSections[i].Title</button>
                }
            </nav>
            <div class="help-body">
                @for (var i = 0; i < helpSections.Count; i++)
                {
                    <section id="help-@i">
                        <h2><span>@helpSections[i].Icon</span> @helpSections[i].Title</h2>
                        @((MarkupString)helpSections[i].Html)
                    </section>
                }
                <footer>WorldView v@(AppVersion)</footer>
            </div>
        </div>
    </div>
}

@if (selection is not null && !isPhone)
{
    @InfoBox(false)
}

@code {
    // Info box: floating, or on phones inside the open list row
    private RenderFragment InfoBox(bool inRow) => @<section class="info @(inRow ? "row-info" : DockOpen ? "dock-open" : "")">
        @if (selection is not null)
        {
        @if (!inRow)
        {
            <header><span>@selection.Title</span><button class="x" title="@T("info.close")" @onclick="ClearSelection">✕</button></header>
        }
        @if (!string.IsNullOrEmpty(selection.Embed))
        {
            @* YouTube player: own play, sound and fullscreen controls *@
            <iframe class="embed" src="@selection.Embed" title="@selection.Title" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        }
        else if (!string.IsNullOrEmpty(selection.Video))
        {
            <video class="media" src="@selection.Video" autoplay muted loop playsinline title="@T("info.enlarge")" @onclick="ToggleEnlarge"></video>
        }
        else if (!string.IsNullOrEmpty(selection.Photo))
        {
            @* Planespotters terms: photo links to its page, photographer credited *@
            <a href="@selection.PhotoLink" target="_blank"><img src="@selection.Photo" alt="@selection.Title" /></a>
            <a class="credit" href="@selection.PhotoLink" target="_blank">© @selection.PhotoBy · Planespotters.net</a>
        }
        else if (!string.IsNullOrEmpty(selection.Image) && selection.IsRadio)
        {
            @* Station logo: small, not enlargeable; hidden when it fails to load *@
            <img class="logo" src="@selection.Image" alt="@selection.Title" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
        }
        else if (!string.IsNullOrEmpty(selection.Image))
        {
            <img class="media" src="@selection.Image" alt="@selection.Title" title="@T("info.enlarge")" @onclick="ToggleEnlarge" />
        }
        <table>
            @foreach (var f in selection.Fields)
            {
                if (f.Length < 2) continue;
                @if (f[1].StartsWith("https://") || f[1].StartsWith("http://"))
                {
                    @* Web address: opens in a new tab *@
                    <tr><th>@f[0]</th><td><a href="@f[1]" target="_blank" rel="noopener noreferrer">@f[1]</a></td></tr>
                }
                else
                {
                    <tr><th>@f[0]</th><td>@f[1]</td></tr>
                }
            }
        </table>
        @if (!string.IsNullOrEmpty(selection.Summary))
        {
            <p class="summary">@selection.Summary</p>
        }
        @if (!string.IsNullOrEmpty(selection.Link))
        {
            <a class="wiki" href="@selection.Link" target="_blank" rel="noopener">@T("info.wiki")</a>
        }
        <div class="info-actions">
            <button @onclick="ZoomToSelection" title="@T("hint.zoomTo")">◎ @T("btn.zoomTo")</button>
            @if (HasMedia)
            {
                <button @onclick="ToggleEnlarge">⤢ @T("btn.enlarge")</button>
            }
            @if (selection.CanCockpit)
            {
                <button class="@(cockpit ? "active" : "")" @onclick="ToggleCockpit">C · Cockpit</button>
                <button class="@(follow ? "active" : "")" @onclick="ToggleFollow" title="@T("hint.follow")">⌖ @T("btn.follow")</button>
                <button @onclick="LoadContacts">@T("btn.contacts")</button>
            }
            @if (selection.IsRadio)
            {
                <button @onclick='() => RadioCall("radioStop")'>■ @T("btn.stopRadio")</button>
            }
        </div>
        @if (contacts is { Count: > 0 })
        {
            <ul class="contacts">
                @foreach (var c in contacts)
                {
                    <li @onclick="() => SelectContact(c)"><span>@c.Label</span><span>@c.DistKm km · @c.Alt.ToString("N0") m</span></li>
                }
            </ul>
        }
        }
    </section>;
}

@if (enlarged && selection is not null && HasMedia)
{
    @* Zoom/pan handled in index.html (wheel, drag, pinch, double-click) *@
    <div class="lightbox" @onclick="ToggleEnlarge">
        <div class="lb-stage">
            @if (!string.IsNullOrEmpty(selection.Video))
            {
                <video class="lb-media" src="@selection.Video" autoplay muted loop playsinline @onclick:stopPropagation="true"></video>
            }
            else
            {
                <img class="lb-media" src="@selection.Image" alt="@selection.Title" draggable="false" @onclick:stopPropagation="true" />
            }
        </div>
        <div class="lb-bar" @onclick:stopPropagation="true">
            <button data-zoom="out" title="−">−</button>
            <button data-zoom="reset" title="1:1">1:1</button>
            <button data-zoom="in" title="+">+</button>
            <span class="lb-cap">@selection.Title · @T("info.zoomHint")</span>
            <button title="@T("info.close")" @onclick="ToggleEnlarge">✕</button>
        </div>
        @if (imgInfo is not null && (imgInfo.Desc + imgInfo.Credit + imgInfo.License + imgInfo.Page).Length > 0)
        {
            @* Image details: description, author, licence, source page *@
            <div class="lb-info" @onclick:stopPropagation="true">
                @if (!string.IsNullOrEmpty(imgInfo.Desc)) { <div>@imgInfo.Desc</div> }
                <div class="lb-credit">
                    @if (!string.IsNullOrEmpty(imgInfo.Credit)) { <span>© @imgInfo.Credit</span> }
                    @if (!string.IsNullOrEmpty(imgInfo.License)) { <span>@imgInfo.License</span> }
                    @if (!string.IsNullOrEmpty(imgInfo.Page)) { <a href="@imgInfo.Page" target="_blank" rel="noopener">@T("info.source") ↗</a> }
                </div>
            </div>
        }
    </div>
}

@if (knmiImg is not null)
{
    <div class="lightbox" @onclick="() => knmiImg = null">
        <div class="lb-stage">
            <img class="lb-media" src="@knmiImg" alt="KNMI" draggable="false" @onclick:stopPropagation="true" />
        </div>
        <div class="lb-bar" @onclick:stopPropagation="true">
            <button data-zoom="out" title="−">−</button>
            <button data-zoom="reset" title="1:1">1:1</button>
            <button data-zoom="in" title="+">+</button>
            <span class="lb-cap">© KNMI / TEMIS · @T("info.zoomHint")</span>
            <button title="@T("info.close")" @onclick="() => knmiImg = null">✕</button>
        </div>
    </div>
}

@if (rowImg is not null)
{
    @* Museum photo from a list row, enlarged (zoom/pan as in the info box) *@
    <div class="lightbox" @onclick="() => rowImg = null">
        <div class="lb-stage">
            <img class="lb-media" src="@rowImg" alt="" draggable="false" @onclick:stopPropagation="true" />
        </div>
        <div class="lb-bar" @onclick:stopPropagation="true">
            <button data-zoom="out" title="−">−</button>
            <button data-zoom="reset" title="1:1">1:1</button>
            <button data-zoom="in" title="+">+</button>
            <span class="lb-cap">@T("info.zoomHint")</span>
            <button title="@T("info.close")" @onclick="() => rowImg = null">✕</button>
        </div>
    </div>
}

@* Bottom dock: airport, museum and radio panels stacked; lists shrink when more are open *@
@if (layers.GetValueOrDefault("radio") || layers.GetValueOrDefault("museums") || layers.GetValueOrDefault("airports") || ListDefs.Any(d => layers.GetValueOrDefault(d.Name)))
{
<div class="dock @(DockBoth ? "both" : "")">
@foreach (var d in ListDefs.Where(d => layers.GetValueOrDefault(d.Name)))
{
    @ListPanel(d)
}
@if (layers.GetValueOrDefault("airports"))
{
    @DockPanel(AirportPanel())
}
@if (layers.GetValueOrDefault("museums"))
{
    @DockPanel(MuseumPanel())
}
@if (layers.GetValueOrDefault("radio"))
{
    @DockPanel(RadioPanel())
}
</div>
}

@if (toast is not null)
{
    <div class="toast">@toast</div>
}

@code {
    private static readonly string AppVersion = GetVersion();
    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private sealed record LayerDef(string Key, string Color);
    private static readonly LayerDef[] LayerDefs =
    [
        new("flights", "#3fd0ff"),
        new("airports", "#c8d2ff"),
        new("military", "#ffb020"),
        new("trains", "#9dff3a"),
        new("ov", "#ffd23f"),
        new("air", "#50f0e6"),
        new("satellites", "#ffffff"),
        new("telescopes", "#00e5ff"),
        new("quakes", "#ff5050"),
        new("fires", "#ff7a1a"),
        new("launches", "#c080ff"),
        new("radio", "#ff4fd8"),
        new("cameras", "#ff3b3b"),
        new("plants", "#ffd23f"),
        new("museums", "#ff8fa3")
    ];
    private static readonly string[] Styles = ["normal", "crt", "nvg", "flir", "ironbow", "noir", "snow"];

    private DotNetObjectReference<WorldConsole>? selfRef;
    private IJSObjectReference? module;
    private readonly Dictionary<string, bool> layers = new();
    private readonly Dictionary<string, (int Count, string Status)> layerStatus = new();
    private string style = "normal", basemap = "esri", ionToken = "", searchText = "";
    private string gpu = "";
    private int nightLight = 60;
    private int detectFont = 14, detectBgAlpha = 60;
    private bool detectBg;
    private bool borders, regions = true, cities = true, coast, eez, nature, streets, timezones, envClick = true;
    private string envOverlay = "";
    private static readonly string[] EnvLayers = ["tempAnom", "lstDay", "lstNight", "sst", "sstAnom", "coral", "seaIce", "no2", "so2", "nh3", "powerYear", "power", "ozoneCams", "ozone", "aod", "rain", "ndvi", "snow"];
    private string envLegend = "";
    private HashSet<string> envMissing = [];
    private string? knmiImg;
    private string envSource = "";
    // KNMI/TEMIS ozone analysis for today (GOME-2 METOP-C); hourly cache key
    private static string KnmiUrl(string view, bool small) =>
        $"https://d1qb6yzwaaq4he.cloudfront.net/protocols/o3field/gome2c/forecast/today_{view}{(small ? "_sm" : "")}.png?h={DateTime.UtcNow:yyyyMMddHH}";
    private readonly Dictionary<string, bool> zoomOn = new();
    private bool hud = true, dayNight = true, trails = true, detect, cockpit, panelToggled, listening, loading = true;
    private string? error, toast;
    private double camLat, camLon, camAlt, camHeading;
    private SelectionInfo? selection;
    private List<ContactInfo>? contacts;
    private int toastId;

    // Translations come from wwwroot/js/i18n.js (single source for UI and engine)
    private Dictionary<string, string> L = new();
    private Dictionary<string, string> langs = new();
    private string lang = "en";
    private string T(string key) => L.TryGetValue(key, out var v) ? v : key;
    private string T(string key, string name, string value) => T(key).Replace("{" + name + "}", value);

    private bool enlarged;
    private bool HasMedia => string.IsNullOrEmpty(selection?.Embed) && (!string.IsNullOrEmpty(selection?.Video) || !string.IsNullOrEmpty(selection?.Image));

    private ImageInfo? imgInfo;

    private async Task ToggleEnlarge()
    {
        enlarged = !enlarged;
        imgInfo = null;
        if (!enlarged || selection is null || module is null || !string.IsNullOrEmpty(selection.Video) || string.IsNullOrEmpty(selection.Image)) return;
        var sel = selection;
        var info = JsonSerializer.Deserialize<ImageInfo>(await module.InvokeAsync<string>("imageInfo", sel.Image, sel.Layer, sel.Key), JsonOpts);
        if (enlarged && selection == sel) imgInfo = info;
    }

    private sealed class ImageInfo
    {
        public string Desc { get; set; } = "";
        public string Credit { get; set; } = "";
        public string License { get; set; } = "";
        public string Page { get; set; } = "";
    }

    private static string GetVersion()
    {
        var info = typeof(WorldConsole).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "0.0.0";
        var plus = info.IndexOf('+');
        return plus >= 0 ? info[..plus] : info;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Row just folded open: scroll it to the top of its list
        if (rowScroll is { } scrollKey && module is not null)
        {
            rowScroll = null;
            await module.InvokeVoidAsync("scrollRowTop", scrollKey);
        }
        if (!firstRender) return;

        // Background update check (GitHub Pages)
        await JS.InvokeVoidAsync("wvUpdater.start", AppVersion);

        try
        {
            selfRef = DotNetObjectReference.Create(this);
            // Version query busts the browser/CDN cache for the engine script
            module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/worldview.js?v={AppVersion}");
            langs = JsonSerializer.Deserialize<Dictionary<string, string>>(await module.InvokeAsync<string>("getLangs"), JsonOpts) ?? new();
            var json = await module.InvokeAsync<string>("init", "globe", selfRef);
            ApplyStrings(await module.InvokeAsync<string>("getStrings"));
            var st = JsonSerializer.Deserialize<InitState>(json, JsonOpts);
            if (st is not null)
            {
                foreach (var (k, v) in st.Layers) layers[k] = v;
                style = st.Style;
                basemap = st.Basemap;
                ionToken = st.IonToken;
                hud = st.Hud;
                detect = st.Detect;
                dayNight = st.DayNight;
                trails = st.Trails;
                nightLight = st.NightLight;
                detectFont = st.DetectFont;
                detectBg = st.DetectBg;
                detectBgAlpha = st.DetectBgAlpha;
                borders = st.Borders;
                regions = st.Regions;
                cities = st.Cities;
                timezones = st.Timezones;
                coast = st.Coast;
                eez = st.Eez;
                nature = st.Nature;
                streets = st.Streets;
                envOverlay = st.EnvOverlay;
                envSource = await module.InvokeAsync<string>("getEnvSource");
                envLegend = await module.InvokeAsync<string>("getEnvLegend");
                envClick = st.EnvClick;
                foreach (var (k, v) in st.Zoom) zoomOn[k] = v;
                gpu = st.Gpu;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
            try { if (module is not null) ApplyStrings(await module.InvokeAsync<string>("getStrings")); } catch { }
        }
        loading = false;
        StateHasChanged();
        if (timezones) await LoadTzZones();
        await RestorePanelFilters();
        if (layers.GetValueOrDefault("radio")) await LoadRadioCountries();
        if (layers.GetValueOrDefault("museums")) await LoadMuseumCountries();
        if (layers.GetValueOrDefault("airports")) await LoadAirportCountries();
        try
        {
            if (module is not null) { envMissing = [.. await module.InvokeAsync<string[]>("getEnvMissing")]; StateHasChanged(); }
        }
        catch { /* fetcher unreachable: keep all options */ }
    }

