    // Debounced: search after typing pauses
    private async Task OnRadioText(ChangeEventArgs e)
    {
        radioText = e.Value?.ToString() ?? "";
        radioTextCts?.Cancel();
        var cts = radioTextCts = new CancellationTokenSource();
        try { await Task.Delay(400, cts.Token); } catch (TaskCanceledException) { return; }
        await SendRadioQuery();
    }

    private Task OnRadioCountry(ChangeEventArgs e) { radioCountry = e.Value?.ToString() ?? ""; return SendRadioQuery(); }
    private Task OnRadioGenre(ChangeEventArgs e) { radioGenre = e.Value?.ToString() ?? ""; return SendRadioQuery(); }
